# Optional local environment variables for the root orchestration scripts.
# Copy this file to .env or export these values in your shell profile.
# Root orchestration scripts auto-load .env from the repository root.
# Do not commit .env.

# Override the Python executable used for Hunyuan3D-1 text-to-3D.
# If unset, scripts prefer Hunyuan3D-1/venv/Scripts/python.exe when present.
HUNYUAN3D1_PYTHON=D:\projects\3d\Hunyuan3D-1\venv\Scripts\python.exe

# Override the Hunyuan3D-2 model snapshot path or Hugging Face repo used by
# scripts/hunyuan2_image.py when --model-path is not supplied.
HUNYUAN3D2_MODEL_PATH=D:\projects\3d\Hunyuan3D-2\tencent\Hunyuan3D-2

# Override the model library root used by scripts/model_collector.py.
# Useful for tests, demos, or keeping generated collections outside the repo.
MODEL_COLLECTOR_MODELS_DIR=D:\projects\3d\models

# Optional external slicer command used by scripts/ai_to_print.py and
# scripts/continuous_print.py when a generated source model must become a
# printer-ready file before queueing. Leave unset unless you have verified the
# slicer command locally. Placeholders: {input}, {output}, {output_dir}.
# Example shape: YOUR_SLICER_EXE --slice "{input}" --output "{output}"
BAMBU_SLICER_COMMAND=

# Extension expected from BAMBU_SLICER_COMMAND. Supported validated outputs are
# .3mf with Bambu/OrcaSlicer project metadata, .gcode, or .bgcode.
BAMBU_SLICER_OUTPUT_EXT=.3mf
